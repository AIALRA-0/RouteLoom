[Unit]
Description=Encrypted RouteLoom PostgreSQL backup

[Service]
Type=oneshot
User=root
Group=root
Environment=COMPOSE_FILE=/opt/routeloom/current/deploy/compose.yaml
Environment=COMPOSE_ENV_FILE=/var/lib/routeloom/production.env
Environment=AGE_RECIPIENT_FILE=/var/lib/routeloom/secrets/backup_age_recipient
Environment=BACKUP_DIR=/var/lib/routeloom/backups
ExecStart=/bin/bash /opt/routeloom/current/deploy/scripts/backup.sh
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/routeloom/backups
