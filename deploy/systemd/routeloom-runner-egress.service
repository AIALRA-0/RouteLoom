[Unit]
Description=Restore RouteLoom Runner egress policy
After=docker.service network-online.target
Requires=docker.service

[Service]
Type=oneshot
WorkingDirectory=/opt/routeloom/current
Environment=PRODUCTION_ENV=/var/lib/routeloom/production.env
ExecStart=/bin/bash /opt/routeloom/current/deploy/scripts/install-runner-egress-policy.sh
RemainAfterExit=yes
NoNewPrivileges=true
ProtectHome=true
ProtectSystem=strict

[Install]
WantedBy=multi-user.target
